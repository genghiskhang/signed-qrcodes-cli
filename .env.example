# AWS region where your DynamoDB table and S3 bucket live
AWS_REGION=us-east-1

# DynamoDB table name — partition key must be "email" (String)
DYNAMODB_TABLE=signed-qrcodes

# S3 bucket for storing generated QR code images
S3_BUCKET=my-qrcodes-bucket

# AES-256 key used to encrypt email addresses (base64-encoded 32 bytes).
# Generate a fresh key with: sqrc-gen --genkey
AES_KEY=

# Optional: explicit AWS credentials. If unset, boto3 uses the standard
# credential chain (IAM role, ~/.aws/credentials, env vars AWS_ACCESS_KEY_ID
# / AWS_SECRET_ACCESS_KEY).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
